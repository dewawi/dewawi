Options -Indexes -MultiViews

RewriteEngine On

# Deny private paths before existing files and directories bypass routing.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,NC]
RewriteRule ^(?:application|configs|languages|logs|session|templates|tests|library/(?:DEEC|Zend)|install/(?:config|templates))(?:/|$) - [F,NC]
RewriteRule ^install/(?!index\.php(?:/|$)).*\.php(?:/|$) - [F,NC]
RewriteRule \.(?:ini|sql|log)(?:[./]|$) - [F,NC]
RewriteRule ^cache/(?:[^/]+/)*zend_cache(?:--|$) - [F,NC]

# Keep only the front controller, installer and authenticated manager routes public.
RewriteRule ^library/(?:FileManager|MediaManager)/(?:dialog|upload|execute|ajax_calls|force_download)\.php$ index.php [L]
RewriteRule ^(?!(?:index\.php|install/index\.php)(?:/|$)).*\.(?:php[0-9]*|phtml|pht|phar|inc)(?:[^a-z0-9]|$) - [F,NC]

RewriteRule ^files/attachments(?:/|$) index.php [NC,L]
RewriteRule ^files/documents(?:/|$) - [F,NC]
RewriteRule ^files/import(?:/|$) - [F,NC]
RewriteRule ^(?:files|media|cache)(?:/|$) index.php [NC,L]

RewriteCond %{REQUEST_FILENAME} -s [OR]
RewriteCond %{REQUEST_FILENAME} -l [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^.*$ - [NC,L]
RewriteRule ^.*$ index.php [NC,L]

FileETag MTime Size

<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=0, must-revalidate" "expr=-f %{REQUEST_FILENAME} && %{REQUEST_URI} =~ m#(?i)\.(?:css|js|woff2?|ttf|otf|eot|ico|png|jpe?g|gif|webp|avif|svg)$# && %{QUERY_STRING} !~ m#(?:^|&)v=[a-f0-9]{12}(?:&|$)#"
    Header set Expires "Thu, 01 Jan 1970 00:00:00 GMT" "expr=-f %{REQUEST_FILENAME} && %{REQUEST_URI} =~ m#(?i)\.(?:css|js|woff2?|ttf|otf|eot|ico|png|jpe?g|gif|webp|avif|svg)$# && %{QUERY_STRING} !~ m#(?:^|&)v=[a-f0-9]{12}(?:&|$)#"
    Header set Cache-Control "public, max-age=31536000, immutable" "expr=-f %{REQUEST_FILENAME} && %{REQUEST_URI} =~ m#(?i)\.(?:css|js|woff2?|ttf|otf|eot|ico|png|jpe?g|gif|webp|avif|svg)$# && %{QUERY_STRING} =~ m#(?:^|&)v=[a-f0-9]{12}(?:&|$)#"

    <IfModule mod_expires.c>
        ExpiresActive On
        ExpiresByType text/css "access plus 1 year"
        ExpiresByType text/javascript "access plus 1 year"
        ExpiresByType application/javascript "access plus 1 year"
    </IfModule>
</IfModule>

<IfModule mod_filter.c>
    <IfModule mod_brotli.c>
        AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
    </IfModule>
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
    </IfModule>
</IfModule>
