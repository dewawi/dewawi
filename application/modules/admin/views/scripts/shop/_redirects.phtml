<?php
$redirectAction = $this->url(['module' => 'admin', 'controller' => 'shop', 'action' => 'legacyredirect', 'id' => (int)$this->shopId], null, true);
$importAction = $this->url(['module' => 'admin', 'controller' => 'shop', 'action' => 'legacyredirectimport', 'id' => (int)$this->shopId], null, true);
$preview = is_array($this->preview) ? $this->preview : [];
$hasErrors = (bool)array_filter($preview, static fn(array $row): bool => $row['status'] === 'error');
?>

<section aria-labelledby="legacy-redirect-heading">
	<h2 id="legacy-redirect-heading"><?php echo $this->escape($this->translate('ADMIN_LEGACY_REDIRECTS')); ?></h2>
	<p><?php echo $this->escape($this->translate('ADMIN_LEGACY_REDIRECTS_INFO')); ?></p>

	<form method="post" action="<?php echo $this->escape($redirectAction); ?>">
		<input type="hidden" name="csrf_token" value="<?php echo $this->escape($this->csrf); ?>">
		<input type="hidden" name="redirect_action" value="create">
		<div class="dw-form-row">
			<label for="legacy-old-path"><?php echo $this->escape($this->translate('ADMIN_LEGACY_OLD_PATH')); ?></label>
			<input id="legacy-old-path" type="text" name="old_path" maxlength="2048" required placeholder="alte-seite">
		</div>
		<div class="dw-form-row">
			<label for="legacy-target-path"><?php echo $this->escape($this->translate('ADMIN_LEGACY_TARGET_PATH')); ?></label>
			<select id="legacy-target-path" name="target_path" required>
				<option value=""><?php echo $this->escape($this->translate('ADMIN_LEGACY_SELECT_TARGET')); ?></option>
				<?php foreach ((array)$this->targets as $target): ?>
					<option value="<?php echo $this->escape($target['path']); ?>"><?php echo $this->escape($target['path']); ?></option>
				<?php endforeach; ?>
			</select>
		</div>
		<button type="submit"><?php echo $this->escape($this->translate('ADMIN_LEGACY_ADD_REDIRECT')); ?></button>
	</form>

	<h3><?php echo $this->escape($this->translate('ADMIN_LEGACY_EXISTING_REDIRECTS')); ?></h3>
	<div class="table-responsive">
		<table>
			<thead><tr>
				<th scope="col"><?php echo $this->escape($this->translate('ADMIN_LEGACY_OLD_PATH')); ?></th>
				<th scope="col"><?php echo $this->escape($this->translate('ADMIN_LEGACY_TARGET_PATH')); ?></th>
				<th scope="col"><?php echo $this->escape($this->translate('ADMIN_LEGACY_STATUS')); ?></th>
				<th scope="col"><?php echo $this->escape($this->translate('ADMIN_LEGACY_ACTION')); ?></th>
			</tr></thead>
			<tbody>
			<?php foreach ((array)$this->redirects as $redirect): ?>
				<tr>
					<td><?php echo $this->escape($redirect['path']); ?></td>
					<td><?php echo $this->escape($redirect['targetpath'] ?: $this->translate('ADMIN_LEGACY_TARGET_UNAVAILABLE')); ?></td>
					<td><?php echo $this->escape($this->translate(empty($redirect['deleted']) ? 'ADMIN_ACTIVE' : 'ADMIN_INACTIVE')); ?></td>
					<td>
					<?php if (empty($redirect['deleted'])): ?>
						<form method="post" action="<?php echo $this->escape($redirectAction); ?>">
							<input type="hidden" name="csrf_token" value="<?php echo $this->escape($this->csrf); ?>">
							<input type="hidden" name="redirect_action" value="disable">
							<input type="hidden" name="redirect_id" value="<?php echo (int)$redirect['id']; ?>">
							<button type="submit"><?php echo $this->escape($this->translate('ADMIN_LEGACY_DISABLE')); ?></button>
						</form>
					<?php endif; ?>
					</td>
				</tr>
			<?php endforeach; ?>
			<?php if (!$this->redirects): ?>
				<tr><td colspan="4"><?php echo $this->escape($this->translate('ADMIN_LEGACY_NONE')); ?></td></tr>
			<?php endif; ?>
			</tbody>
		</table>
	</div>

	<h3><?php echo $this->escape($this->translate('ADMIN_LEGACY_CSV_IMPORT')); ?></h3>
	<p><?php echo $this->escape($this->translate('ADMIN_LEGACY_CSV_INFO')); ?></p>
	<form method="post" enctype="multipart/form-data" action="<?php echo $this->escape($importAction); ?>">
		<input type="hidden" name="csrf_token" value="<?php echo $this->escape($this->csrf); ?>">
		<input type="hidden" name="import_action" value="preview">
		<label for="legacy-csv"><?php echo $this->escape($this->translate('ADMIN_LEGACY_CSV_FILE')); ?></label>
		<input id="legacy-csv" type="file" name="redirect_csv" accept=".csv,text/csv" required>
		<button type="submit"><?php echo $this->escape($this->translate('ADMIN_LEGACY_PREVIEW')); ?></button>
	</form>

	<?php if ($preview): ?>
		<h3><?php echo $this->escape($this->translate('ADMIN_LEGACY_IMPORT_PREVIEW')); ?></h3>
		<div class="table-responsive">
			<table>
				<thead><tr><th scope="col"><?php echo $this->escape($this->translate('ADMIN_LEGACY_LINE')); ?></th><th scope="col"><?php echo $this->escape($this->translate('ADMIN_LEGACY_OLD_PATH')); ?></th><th scope="col"><?php echo $this->escape($this->translate('ADMIN_LEGACY_TARGET_PATH')); ?></th><th scope="col"><?php echo $this->escape($this->translate('ADMIN_LEGACY_STATUS')); ?></th></tr></thead>
				<tbody>
				<?php foreach ($preview as $row): ?>
					<tr><td><?php echo (int)$row['line']; ?></td><td><?php echo $this->escape($row['old_path']); ?></td><td><?php echo $this->escape($row['target_path']); ?></td><td><?php echo $this->escape($row['error'] ? $this->translate($row['error']) : $this->translate('ADMIN_LEGACY_IMPORT_' . strtoupper($row['status']))); ?></td></tr>
				<?php endforeach; ?>
				</tbody>
			</table>
		</div>
		<form method="post" action="<?php echo $this->escape($importAction); ?>">
			<input type="hidden" name="csrf_token" value="<?php echo $this->escape($this->csrf); ?>">
			<input type="hidden" name="preview_token" value="<?php echo $this->escape($this->previewToken); ?>">
			<button type="submit" name="import_action" value="confirm"<?php echo $hasErrors ? ' disabled' : ''; ?>><?php echo $this->escape($this->translate('ADMIN_LEGACY_IMPORT_CONFIRM')); ?></button>
			<button type="submit" name="import_action" value="cancel"><?php echo $this->escape($this->translate('ADMIN_LEGACY_IMPORT_CANCEL')); ?></button>
		</form>
	<?php endif; ?>
</section>
