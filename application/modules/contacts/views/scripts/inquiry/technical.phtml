	<dl class="view">
	<?php foreach(['cooling_capacity' => 'CONTACT_TECH_COLD_HEAT', 'power_input' => 'CONTACT_TECH_POWER', 'refrigerant_mass_flow' => 'CONTACT_TECH_MASS_FLOW', 'current' => 'CONTACT_TECH_CURRENT', 'discharge_temperature' => 'CONTACT_TECH_DISCHARGE'] as $key => $label): $quantity = $quantities[$key] ?? null; if(!$quantity) continue; ?>
		<dt><?php echo $t($label); ?><?php if($quantity['unit'] ?? null) echo ' ('.$e($quantity['unit']).')'; ?></dt><dd><?php echo $quantity['value'] === null ? $t('CONTACT_TECH_MISSING') : $e($quantity['value']); ?></dd>
	<?php endforeach; ?>
	</dl>
