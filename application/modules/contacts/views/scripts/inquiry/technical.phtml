<p><a class="dw-btn" href="<?php echo $e($this->url(['module' => 'contacts', 'controller' => 'inquiry', 'action' => 'view', 'id' => (int)$v['inquiry']['id']], null, true)); ?>"><?php echo $t('CONTACT_TECH_BACK'); ?></a> · <?php echo $t('CONTACT_INQUIRIES_REQUEST'); ?> #<?php echo (int)$v['inquiry']['id']; ?></p>
