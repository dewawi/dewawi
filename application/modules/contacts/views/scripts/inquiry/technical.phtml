		<?php if($choice['input'] === 'stage'): ?>
		<label><?php echo $t('CONTACT_TECH_STAGE_KEY'); ?><select name="stage" required><option value=""><?php echo $t('CONTACT_TECH_CHOOSE'); ?></option><?php foreach($d->stages as $stage): ?><option value="<?php echo $e($stage->stage_key); ?>"<?php if($value('stage') === $stage->stage_key) echo ' selected'; ?>><?php echo $e($stage->stage_key); ?></option><?php endforeach; ?></select></label>
		<?php endif; ?>
		<?php foreach($choice['input'] === 'stage' ? $d->circuits : [null] as $circuit): ?>
