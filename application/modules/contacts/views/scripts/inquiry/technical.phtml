		<dt><?php echo $t('CONTACT_TECH_COMMERCIAL_STATUS'); ?></dt><dd><?php echo $t('CONTACT_TECH_NO_RELEASE'); ?></dd>
		<dt><?php echo $t('CONTACT_TECH_SCOPE'); ?></dt><dd><?php echo $e($result['scope'] ?? $result['calculation_version'] ?? $result['evaluation_mode']); ?></dd>
	</dl>
	<p><?php echo $t('CONTACT_TECH_BOUNDARY'); ?></p>
	<?php $solution = $result['solution'] ?? []; $point = $solution['point'] ?? null; ?>
	<dl class="view">
