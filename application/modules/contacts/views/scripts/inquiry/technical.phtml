		<label><?php echo $t($label); ?> (°C)<input type="number" step="any" name="<?php echo $e($fieldName); ?>" value="<?php echo $e(is_string($fieldValue) ? $fieldValue : ''); ?>" required></label>
		<?php endforeach; ?>
		</div>
		<?php endforeach; ?>
	<?php endif; ?>
	<div class="dw-form-row"><label><input type="checkbox" name="reference" value="1"<?php if($value('reference') === '1') echo ' checked'; ?>> <?php echo $t('CONTACT_TECH_REFERENCE'); ?></label></div>
	<button class="dw-btn" type="submit"><?php echo $t('CONTACT_TECH_RUN'); ?></button>
</form>
<?php if(!$v['result']) return; $result = $v['result']; ?>
<section id="inquiry-technical-result">
	<h3><?php echo $t('CONTACT_TECH_RESULT'); ?></h3>
	<?php if($v['reference']): ?><p class="dw-alert dw-alert--warning"><?php echo $t('CONTACT_TECH_DEMO'); ?></p><?php endif; ?>
	<dl class="view">
		<dt><?php echo $t('CONTACT_TECH_MATH_STATUS'); ?></dt><dd><?php echo $e($result['mathematical_status'] ?? (isset($result['mathematical_converged']) ? ($result['mathematical_converged'] ? 'converged' : 'blocked') : (($result['solution'] ?? $result['calculation'] ?? null) !== null ? 'calculated' : 'see_details'))); ?></dd>
