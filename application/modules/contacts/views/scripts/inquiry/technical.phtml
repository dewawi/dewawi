	<details><summary><?php echo $t('CONTACT_TECH_REQUEST'); ?></summary><pre><?php echo $e($json($v['request'])); ?></pre></details>
	<details><summary><?php echo $t('CONTACT_TECH_DETAILS'); ?></summary><pre><?php echo $e($json(array_diff_key($result, ['dependencies' => true]))); ?></pre></details>
