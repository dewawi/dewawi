<?php endforeach; ?>
</tbody></table></div>
<details><summary><?php echo $t('CONTACT_TECH_VARIANT'); ?></summary><pre><?php echo $e($json((object)['article_id' => (int)$v['item']['id'], 'base_article_id' => $v['item']['parentid'], 'signature' => $d->variant_signature, 'equipment' => $d->selected_equipment, 'option_bindings' => $m['options']])); ?></pre></details>
