<?php
$this->title = $this->translate('STATISTICS');
$this->headTitle($this->title);
?>

<?php if($this->customerList) : ?>
	<h3><?php echo $this->translate('STATISTICS_CUSTOMER_TOP_TEN'); ?></h3>
	<img src="data:image/png;base64,<?php echo $this->chartImages['customer']; ?>">

	<h3><?php echo $this->translate('STATISTICS_CUSTOMER_LIST'); ?></h3>
	<?php echo $this->customerListTable->render(); ?>
<?php else : ?>
	<p><?php echo $this->translate('STATISTICS_NO_DATA'); ?></p>
<?php endif; ?>

<h3><?php echo $this->translate('STATISTICS_CUSTOMER_YEARLY'); ?></h3>
<p><?php echo $this->translate('STATISTICS_CUSTOMER_YEARLY_NOTE'); ?></p>

<?php echo $this->yearlySummaryTable->render(); ?>

<?php foreach($this->yearlyTables as $year => $table) : ?>
    <h3><?php echo $this->translate('STATISTICS_CUSTOMER_TOP_THIRTY').' '.$this->escape((string)$year); ?></h3>

    <?php if($table->hasItems()) : ?>
        <?php echo $table->render(); ?>
    <?php else : ?>
        <p><?php echo $this->translate('STATISTICS_NO_DATA'); ?></p>
    <?php endif; ?>
<?php endforeach; ?>
