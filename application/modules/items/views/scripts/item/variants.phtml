<div
	class="dw-section"
	data-section="variants"
	data-refresh="html"
>
	<?php if(empty($this->item['parentid'])): ?>

		<form
			method="post"
			action="/items/variant/add"
		>
			<input
				type="hidden"
				name="parentid"
				value="<?php echo (int)$this->item['id']; ?>"
			>

			<button
				type="submit"
				class="dw-btn dw-btn--action"
			>
				<?php echo $this->translate(
					'ITEMS_VARIANT_ADD'
				); ?>
			</button>
		</form>

		<?php if(!count($this->variants)): ?>

			<p>
				<?php echo $this->translate(
					'ITEMS_VARIANTS_EMPTY'
				); ?>
			</p>

		<?php else: ?>

			<table class="dw-table">
				<thead>
					<tr>
						<th>
							<?php echo $this->translate(
								'ITEMS_SKU'
							); ?>
						</th>

						<th>
							<?php echo $this->translate(
								'ITEMS_TITLE'
							); ?>
						</th>

						<th>
							<?php echo $this->translate(
								'ITEMS_PRICE'
							); ?>
						</th>
					</tr>
				</thead>

				<tbody>
					<?php foreach($this->variants as $variant): ?>
						<tr>
							<td>
								<a
									href="/items/item/edit/id/<?php
										echo (int)$variant->id;
									?>"
								>
									<?php echo $this->escape(
										$variant->sku
									); ?>
								</a>
							</td>

							<td>
								<?php echo $this->escape(
									$variant->title
								); ?>
							</td>

							<td>
								<?php echo $this->escape(
									$variant->price
								); ?>
							</td>
						</tr>
					<?php endforeach; ?>
				</tbody>
			</table>

		<?php endif; ?>

	<?php else: ?>

		<?php
		$selectedOptions = [];

		foreach($this->variantOptions as $relation) {
			$selectedOptions[
				(int)$relation->itemoptid
			] = true;
		}
		?>

		<h4>
			<?php echo $this->translate(
				'ITEMS_VARIANT_OPTIONS'
			); ?>
		</h4>

		<div
			class="dw-variant-options"
			data-variant-id="<?php echo (int)$this->item['id']; ?>"
		>
			<?php if(!count($this->availableOptions)): ?>

				<p>
					<?php echo $this->translate(
						'ITEMS_VARIANT_OPTIONS_EMPTY'
					); ?>
				</p>

			<?php else: ?>

				<?php foreach($this->availableOptions as $option): ?>
					<?php
					$optionId = (int)$option->id;

					$checked = isset(
						$selectedOptions[$optionId]
					);
					?>

					<label class="dw-variant-option">
						<input
							type="checkbox"
							class="variant-option"
							data-option-id="<?php echo $optionId; ?>"
							<?php echo $checked
								? 'checked'
								: ''; ?>
						>

						<span class="dw-variant-option__content">

							<?php if(!empty($option->sku)): ?>
								<strong class="dw-variant-option__sku">
									<?php echo $this->escape(
										$option->sku
									); ?>
								</strong>
							<?php endif; ?>

							<?php if(!empty($option->title)): ?>
								<span class="dw-variant-option__title">
									<?php echo $this->escape(
										$option->title
									); ?>
								</span>
							<?php endif; ?>

							<?php if((float)$option->price !== 0.0): ?>
								<span class="dw-variant-option__price">
									<?php echo $this->escape(
										$option->price
									); ?>
								</span>
							<?php endif; ?>

						</span>
					</label>

				<?php endforeach; ?>

			<?php endif; ?>
		</div>

	<?php endif; ?>
</div>
