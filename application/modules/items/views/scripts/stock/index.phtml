<?php

$this->title = $this->translate('ITEMS_STOCK');
$this->headTitle($this->title);

echo $this->Messages();
echo $this->Pagination();

?>

<div class="dw-list-page">
	<?php echo $this->stocks->render(); ?>
</div>

<?php if(isset($this->stockTotalValue)): ?>
	<div class="dw-stock-summary">
		<div>
			<strong>
				<?php echo $this->translate(
					'ITEMS_STOCK_TOTAL_VALUE'
				) ?>:
			</strong>

			<?php echo $this->currency(
				$this->stockTotalValue
			) ?>
		</div>

		<?php if(!empty($this->showStockFilteredValue)): ?>
			<div>
				<strong>
					<?php echo $this->translate(
						'ITEMS_STOCK_FILTERED_VALUE'
					) ?>:
				</strong>

				<?php echo $this->currency(
					$this->stockFilteredValue
				) ?>
			</div>
		<?php endif; ?>

		<div>
			<strong>
				<?php echo $this->translate(
					'ITEMS_STOCK_FOUND_ITEMS'
				) ?>:
			</strong>

			<?php echo (int)$this->stockRecords ?>
		</div>

		<?php if(!empty($this->showStockPageValue)): ?>
			<div>
				<strong>
					<?php echo $this->translate(
						'ITEMS_STOCK_PAGE_VALUE'
					) ?>:
				</strong>

				<?php echo $this->currency(
					$this->stockPageValue
				) ?>
			</div>
		<?php endif; ?>
	</div>
<?php endif; ?>
