<?php

$page = is_array($this->page ?? null) ? $this->page : [];
$content = (string)($page['content'] ?? '');

$metaTitle = trim((string)($page['metatitle'] ?? ''));
$metaDescription = trim((string)($page['metadescription'] ?? ''));

if ($metaTitle !== '') {
	$this->headTitle($metaTitle);
}

if ($metaDescription !== '') {
	$this->headMeta()->setName('description', $metaDescription);
}

$pageblocks = is_array($this->pageblocks ?? null) ? $this->pageblocks : [];
$categories = is_array($this->categories ?? null) ? $this->categories : [];
$contact = $this->siteContext->hasFeature('contact') ? $this->ContactForm($this->translate('SHOPS_CONTACT_FORM')) : '';

$hasCategoryBlock = false;

foreach ($pageblocks as $pageblock) {
	if (($pageblock['type'] ?? '') === 'categories') {
		$hasCategoryBlock = true;
		break;
	}
}

$categoryHtml = $this->RenderCategories($categories);
$hasCategoryPlaceholder = strpos($content, '{categories}') !== false;

$content = str_replace('{categories}', $categoryHtml, $content);
$content = str_replace('{contact}', $contact, $content);

?>

<?php if ($pageblocks): ?>

	<?php echo $this->RenderPageBlocks($pageblocks); ?>

<?php else: ?>

	<?php if (!empty($this->slideImages)): ?>
		<?php echo $this->Slide($this->slideImages); ?>
	<?php endif; ?>

<?php endif; ?>

<?php if (!$hasCategoryBlock && !$hasCategoryPlaceholder && $categoryHtml !== ''): ?>
	<section id="categories" class="py-5">
		<div class="container">
			<?php echo $categoryHtml; ?>
		</div>
	</section>
<?php endif; ?>

<?php if (trim($content) !== ''): ?>
	<section id="about" class="py-5">
		<div class="container">
			<?php echo $content; ?>
		</div>
	</section>
<?php endif; ?>
