<section id="cart" class="jumbotron jumbotron-fluid py-5">
	<div class="container">
		<h2 class="text-center mb-4"><?php echo $this->translate('SHOPS_SHOPPING_CART'); ?></h2>
		<div class="cart-wrapper">
			<!-- Cart Container -->
			<div id="cart-container">
				<?php if (!empty($this->items)) : ?>
					<div class="cart-header d-flex justify-content-between align-items-center">
						<span><?php echo $this->translate('SHOPS_PRODUCT'); ?></span>
						<span><?php echo $this->translate('SHOPS_PRICE'); ?></span>
						<span><?php echo $this->translate('SHOPS_QUANTITY'); ?></span>
						<span><?php echo $this->translate('SHOPS_TOTAL'); ?></span>
						<span><?php echo $this->translate('SHOPS_ACTIONS'); ?></span>
					</div>
					<div id="cart-items" aria-live="polite" data-quantity-label="<?php echo $this->translate('SHOPS_QUANTITY'); ?>" data-remove-label="<?php echo $this->translate('SHOPS_REMOVE'); ?>" data-empty-label="<?php echo $this->translate('SHOPS_SHOPPING_CART_EMPTY'); ?>">
						<?php foreach ($this->items as $id => $item) : ?>
							<div class="cart-item d-flex justify-content-between align-items-center" data-id="<?php echo (int)$id; ?>">
								<div class="product-details" style="flex: 2; display: flex; flex-direction: column; justify-content: center;">
									<?php $itemUrl = $this->SlugUrl('item', (int)$id); ?>
									<?php if($itemUrl) : ?>
										<a href="<?php echo $itemUrl; ?>">
											<strong class="product-title"><?php echo $this->escape($item['title']); ?></strong>
										</a>
									<?php else : ?>
										<strong class="product-title"><?php echo $this->escape($item['title']); ?></strong>
									<?php endif; ?>
									<div class="product-sku text-muted">
									<?php echo $this->translate('SHOPS_SKU'); ?>: <?php echo $this->escape($item['sku']); ?>
									</div>
								</div>
								<div style="flex: 1; text-align: center;"><?php echo $item['price']; ?></div>
								<div style="flex: 1; text-align: center;">
									<input type="number" class="form-control quantity-input" value="<?php echo $this->escape($item['quantity']); ?>" min="1" data-id="<?php echo (int)$id; ?>">
								</div>
								<div style="flex: 1; text-align: center;" class="item-total"><?php echo $item['total']; ?></div>
								<div style="flex: 1; text-align: center;">
									<button class="btn btn-danger btn-sm remove-item" type="button" data-id="<?php echo (int)$id; ?>"><?php echo $this->translate('SHOPS_REMOVE'); ?></button>
								</div>
							</div>
						<?php endforeach; ?>
					</div>
					<div class="cart-summary d-flex justify-content-between align-items-center mt-3">
						<h4><?php echo $this->translate('SHOPS_TOTAL') . ':'; ?> <span id="cart-total"><?php echo $this->total; ?></span></h4>
						<?php $shippingPage = $this->PageByType('shipping'); ?>
						<?php if($shippingPage) : ?>
							<span style="font-size: 0.8rem;"><?php echo $this->translate('SHOPS_NET_PRICE_NOTICE'); ?> <a href="<?php echo $this->SlugUrl('page', (int)$shippingPage['id']); ?>" target="_blank"><?php echo $this->translate('SHOPS_SHIPPING_COSTS'); ?></a></span>
						<?php endif; ?>
						<button class="btn btn-warning" id="clear-cart" type="button"><?php echo $this->translate('SHOPS_SHOPPING_CART_CLEAR'); ?></button>
						<button id="checkout-btn" class="btn btn-success" type="button"><?php echo $this->translate('SHOPS_CHECKOUT'); ?></button>
					</div>
				<?php else : ?>
					<p><?php echo $this->translate('SHOPS_SHOPPING_CART_EMPTY'); ?></p>
				<?php endif; ?>
			</div>
		</div>
	</div>
</section>
