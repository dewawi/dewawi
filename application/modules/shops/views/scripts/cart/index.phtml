<section id="cart" class="jumbotron jumbotron-fluid py-5">
	<div class="container">
		<?php echo $this->Messages(); ?>
		<h2 class="text-center mb-4"><?php echo $this->translate('SHOPS_SHOPPING_CART'); ?></h2>
		<div class="cart-wrapper">
			<div id="cart-container" aria-busy="false">
				<div class="cart-header"<?php if (!$this->items) echo ' hidden'; ?>>
					<?php foreach (['SHOPS_PRODUCT', 'SHOPS_PRICE', 'SHOPS_QUANTITY', 'SHOPS_TOTAL', 'SHOPS_ACTIONS'] as $label) : ?>
						<span><?php echo $this->translate($label); ?></span>
					<?php endforeach; ?>
				</div>
				<div id="cart-items">
					<?php foreach ($this->items as $id => $item) : ?>
						<div class="cart-item" data-id="<?php echo (int)$id; ?>">
							<div class="product-details">
								<?php $itemUrl = $this->SlugUrl('item', (int)$id); ?>
								<?php if ($itemUrl) : ?><a href="<?php echo $this->escape($itemUrl); ?>"><?php endif; ?>
								<strong class="product-title"><?php echo $this->escape($item['title']); ?></strong>
								<?php if ($itemUrl) : ?></a><?php endif; ?>
								<div class="product-sku text-muted"><?php echo $this->translate('SHOPS_SKU'); ?>: <?php echo $this->escape($item['sku']); ?></div>
							</div>
							<div class="cart-price" data-label="<?php echo $this->escape($this->translate('SHOPS_PRICE')); ?>"><?php echo $item['price']; ?></div>
							<div class="cart-quantity" data-label="<?php echo $this->escape($this->translate('SHOPS_QUANTITY')); ?>">
								<input type="number" class="form-control quantity-input" value="<?php echo $this->escape($item['quantity']); ?>" min="0" max="100000" step="0.0001" data-id="<?php echo (int)$id; ?>" aria-label="<?php echo $this->escape($this->translate('SHOPS_QUANTITY') . ' ' . $item['title']); ?>">
								<span class="cart-uom"><?php echo $this->escape($item['uom'] ?? ''); ?></span>
							</div>
							<div class="item-total" data-label="<?php echo $this->escape($this->translate('SHOPS_TOTAL')); ?>"><?php echo $item['total']; ?></div>
							<div class="cart-actions"><button class="btn btn-danger btn-sm remove-item" type="button" data-id="<?php echo (int)$id; ?>" aria-label="<?php echo $this->escape($this->translate('SHOPS_REMOVE') . ' ' . $item['title']); ?>"><?php echo $this->translate('SHOPS_REMOVE'); ?></button></div>
						</div>
					<?php endforeach; ?>
				</div>
				<p id="cart-empty"<?php if ($this->items) echo ' hidden'; ?>><?php echo $this->translate('SHOPS_SHOPPING_CART_EMPTY'); ?></p>
				<div class="cart-summary mt-3"<?php if (!$this->items) echo ' hidden'; ?>>
					<h4><?php echo $this->translate('SHOPS_TOTAL'); ?>: <span id="cart-total"><?php echo $this->total; ?></span></h4>
					<div class="cart-summary-actions">
						<button class="btn btn-warning" id="clear-cart" type="button"><?php echo $this->translate('SHOPS_SHOPPING_CART_CLEAR'); ?></button>
						<?php if ($this->siteContext->hasFeature('checkout')) : ?>
							<button id="checkout-btn" class="btn btn-success" type="button"><?php echo $this->translate('SHOPS_CHECKOUT'); ?></button>
						<?php endif; ?>
					</div>
				</div>
				<?php if (!$this->siteContext->hasFeature('checkout')) : ?><p class="mt-3"><?php echo $this->translate('SHOPS_CART_CHECKOUT_DISABLED'); ?></p><?php endif; ?>
				<p class="small mt-3"><?php echo $this->translate('SHOPS_CART_NET_NOTICE'); ?>
					<?php $shippingPage = $this->PageByType('shipping'); ?>
					<?php if ($shippingPage) : ?><a href="<?php echo $this->escape($this->SlugUrl('page', (int)$shippingPage['id'])); ?>"><?php echo $this->translate('SHOPS_SHIPPING_COSTS'); ?></a><?php endif; ?>
				</p>
			</div>
		</div>
	</div>
</section>
