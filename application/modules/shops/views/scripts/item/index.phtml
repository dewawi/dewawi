<?php

$item = $this->item;
$item['shopdescription'] = DEEC_Filter::removeEmptyHeadings((string)($item['shopdescription'] ?? ''));
$item['shopdescriptionshort'] = DEEC_Filter::removeEmptyHeadings((string)($item['shopdescriptionshort'] ?? ''));
$item['shopdescriptionmini'] = DEEC_Filter::removeEmptyHeadings((string)($item['shopdescriptionmini'] ?? ''));
$this->item = $item;
$itemId = (int)$item['id'];
$itemTitle = trim((string)($item['title'] ?? ''));
$itemUrl = $this->SlugUrl('item', $itemId);
$itemMedia = is_array($this->images ?? null) ? $this->images : [];
$itemImages = array_values(array_filter($itemMedia, static function($media) {
	return ($media['type'] ?? '') === 'image';
}));
$previewImage = $itemImages[0] ?? null;
$downloads = false;
$contentHasH1 = preg_match('/<h1\b/i', (string)($item['shopdescription'] ?: $item['description'])) === 1;

$this->title = $itemTitle;
$metaDescription = trim(html_entity_decode(strip_tags((string)($item['shopdescriptionshort'] ?: ($item['shopdescription'] ?: $item['description']))), ENT_QUOTES | ENT_HTML5, 'UTF-8'));
$seo = $this->SiteMetadata([
	'title' => $itemTitle,
	'description' => $metaDescription,
	'type' => 'product',
	'imageDirectory' => $previewImage ? 'images' : null,
	'image' => $previewImage['url'] ?? null,
]);

$hasSpecial = !empty($this->prices['rawspecialprice']);
$base = (float)($this->prices['raw'] ?? 0);
$special = (float)($this->prices['rawspecialprice'] ?? 0);
$discountPct = $hasSpecial && $base > 0 && $special > 0 && $special < $base ? round((1 - ($special / $base)) * 100) : null;

$itemImageUrls = [];
foreach ($itemImages as $image) {
	$imageUrl = $seo->mediaUrl('images', (string)$image['url']);
	if ($imageUrl !== null) $itemImageUrls[] = $imageUrl;
}

$productSchema = [
	'@context' => 'https://schema.org',
	'@type' => 'Product',
	'name' => $itemTitle,
];

$sku = trim((string)($item['sku'] ?? ''));
if ($metaDescription !== '') $productSchema['description'] = $metaDescription;
if ($sku !== '') $productSchema['sku'] = $sku;
if ($itemImageUrls) $productSchema['image'] = $itemImageUrls;

$manufacturer = trim((string)($this->manufacturers[(int)($item['manufacturerid'] ?? 0)] ?? ''));

if ($manufacturer !== '') {
	$productSchema['brand'] = [
		'@type' => 'Brand',
		'name' => $manufacturer,
	];
}

$productUrl = is_string($itemUrl) ? $seo->absoluteUrl($itemUrl) : null;
$price = $hasSpecial && (float)($this->prices['rawspecialprice'] ?? 0) > 0
	? (float)($this->prices['rawspecialpricetax'] ?? 0)
	: (float)($this->prices['rawtax'] ?? 0);
$currency = strtoupper(trim((string)($item['currency'] ?? '')));

if ($productUrl !== null && $price > 0 && preg_match('/^[A-Z]{3}$/', $currency)) {
	$productSchema['offers'] = [
		'@type' => 'Offer',
		'url' => $productUrl,
		'priceCurrency' => $currency,
		'price' => $price,
	];
}
?>
<?php if ($itemTitle !== '') echo $seo->jsonLd($productSchema); ?>

<section id="item" class="py-5">
	<div class="container">
		<div class="row">
			<?php if(!$contentHasH1) : ?>
				<div class="col-md-12 mb-4">
					<h1><?php echo $this->escape($this->item['title']); ?></h1>
				</div>
			<?php endif; ?>
			<div class="col-md-6 mb-4">
				<div class="main-image-wrapper">
					<?php if($previewImage) : ?>
						<button class="dw-product-image-button" type="button" data-toggle="modal" data-target="#imageModal" aria-label="<?php echo $this->translate('SHOPS_OPEN_GALLERY'); ?>">
						<?php
						$imageAlt = trim((string)($previewImage['title'] ?? '')) ?: $itemTitle;
						echo $this->SiteImage('/media/images/' . (string)$previewImage['url'], $imageAlt, [
							'id' => 'mainImage',
							'class' => 'img-fluid',
							'loading' => false,
							'fetchpriority' => 'high',
							'sizes' => '(max-width: 767.98px) 100vw, 50vw',
						]);
						?>
						</button>
					<?php endif; ?>
				</div>
				<?php if($previewImage) : ?>
					<span class="imagetitle"><?php echo $this->escape($previewImage['title'] ?? ''); ?></span>
					<span class="imagedescription"></span>
				<?php endif; ?>
				<div class="row">
					<?php if($itemImages) : ?>
						<div class="modal fade" id="imageModal" tabindex="-1" role="dialog" aria-labelledby="imageModalLabel" aria-hidden="true">
							<div class="modal-dialog modal-xl" role="document">
								<div class="modal-content">
									<div class="modal-header">
										<h2 class="modal-title h5" id="imageModalLabel"><?php echo $this->escape($itemTitle); ?></h2>
										<button type="button" class="close" data-dismiss="modal" aria-label="<?php echo $this->translate('SHOPS_CLOSE'); ?>"><span aria-hidden="true">&times;</span></button>
									</div>
									<div class="modal-body">
										<div id="carouselExampleControls" class="carousel slide" data-interval="false">
											<div class="carousel-inner">
												<?php foreach($itemImages as $index => $image) : ?>
													<div class="carousel-item<?php echo $index === 0 ? ' active' : ''; ?>">
														<div class="modal-image-wrapper">
														<?php
														$imageAlt = trim((string)($image['title'] ?? '')) ?: $itemTitle;
														echo $this->SiteImage('/media/images/' . (string)$image['url'], $imageAlt, [
															'class' => 'd-block w-100',
															'sizes' => '100vw',
														]);
														?>
														</div>
														<?php if(!empty($image['title'])) : ?>
															<span><?php echo $this->escape($image['title']); ?></span>
														<?php endif; ?>
													</div>
												<?php endforeach; ?>
											</div>

											<?php if(count($itemImages) > 1) : ?>
												<button class="carousel-control-prev" type="button" data-target="#carouselExampleControls" data-slide="prev">
													<span class="carousel-control-prev-icon" aria-hidden="true"></span>
													<span class="sr-only"><?php echo $this->translate('SHOPS_PREVIOUS'); ?></span>
												</button>
												<button class="carousel-control-next" type="button" data-target="#carouselExampleControls" data-slide="next">
													<span class="carousel-control-next-icon" aria-hidden="true"></span>
													<span class="sr-only"><?php echo $this->translate('SHOPS_NEXT'); ?></span>
												</button>
											<?php endif; ?>
										</div>
									</div>
								</div>
							</div>
						</div>
					<?php endif; ?>
				</div>
			</div>
			<div class="col-md-6 mb-4">
				<?php if($this->item['shopdescription']) : ?>
					<p><?php echo $this->item['shopdescription']; ?></p>
				<?php else : ?>
					<p><?php echo nl2br($this->item['description']); ?></p>
				<?php endif; ?>
				<p><?php //echo $this->item['shopdescriptionshort']; ?></p>

				<div style="margin-bottom: 10px;">
					<span><?php echo $this->translate('SHOPS_SKU'); ?>: <?php echo $this->escape($this->item['sku']); ?></span>
				</div>

				<div style="margin-bottom: 10px;">
					<p style="margin-bottom: 0;">
						<?php if($hasSpecial) : ?>
							<strong style="color: #008000; font-size: 1.3rem;">
								Sonderpreis: <?php echo $this->prices['formattedspecialprice']; ?>
								<?php if ($discountPct !== null): ?>
									<span class="badge bg-danger ms-2" style="color: #ffffff;">-<?= $discountPct; ?>%</span>
								<?php endif; ?>
							</strong> *<br>
							<span style="text-decoration: line-through; font-size: 1.3rem;">
								Listenpreis: <?php echo $this->prices['formatted']; ?>
							</span><br>
							<?php if($this->siteContext->hasFeature('inquiry')) : ?>
								<strong>Für Ihren individuellen Rabatt senden Sie uns einfach eine Anfrage!</strong>
							<?php endif; ?>
						<?php else : ?>
							<span style="font-size: 1.3rem;">Listenpreis: <?php echo $this->prices['formatted']; ?></span> *<br>
							<?php if($this->siteContext->hasFeature('inquiry')) : ?>
								<strong>Für Ihren individuellen Rabatt senden Sie uns einfach eine Anfrage!</strong>
							<?php endif; ?>
						<?php endif; ?>
					</p>
					<?php if($this->prices['rawtax'] > $this->prices['raw']) : ?>
						<?php if($this->prices['rawspecialprice']) : ?>
							<p style="margin-bottom: 0; font-size: 0.8rem;"><?php echo $this->prices['formattedspecialpricetax']; ?> inkl. MwSt.</p>
						<?php else : ?>
							<p style="margin-bottom: 0; font-size: 0.8rem;"><?php echo $this->prices['formattedtax']; ?> inkl. MwSt.</p>
						<?php endif; ?>
					<?php endif; ?>
					<?php $shippingPage = $this->PageByType('shipping'); ?>
					<?php if($shippingPage) : ?>
						<span style="font-size: 0.8rem;">* Preise exkl. MwSt. zzgl. <a href="<?php echo $this->SlugUrl('page', (int)$shippingPage['id']); ?>" target="_blank">Versandkosten</a></span>
					<?php endif; ?>
				</div>

				<div>
					<?php if($this->siteContext->hasFeature('cart')) : ?>
						<button class="btn btn-primary btn-lg add-to-cart" type="button" data-id="<?php echo $this->item['id']; ?>">
							<?php echo $this->translate('SHOPS_ADD_TO_CART'); ?>
						</button>
					<?php endif; ?>
					<?php if($this->siteContext->hasFeature('inquiry')) : ?>
						<button class="btn btn-info btn-lg" type="button" data-show-section="inquiry"><?php echo $this->translate('SHOPS_SEND_INQUIRY'); ?></button>
					<?php endif; ?>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- Attributes -->
<section id="attributes" class="py-5">
	<div class="container">
		<h2 class="text-center mb-4"><?php echo $this->translate('SHOPS_ATTRIBUTES'); ?></h2>
		<?php if (!empty($this->attributeSets)) : ?>
			<div class="card card-body">
				<div class="row">
					<?php foreach ($this->attributeSets as $attributeSet) : ?>
						<div class="col-md-4 mb-4">
							<div class="card">
								<div class="card-header">
									<h5 class="mb-0"><?php echo $attributeSet['title']; ?></h5>
								</div>
								<div class="card-body">
									<ul class="list-unstyled">
										<?php foreach ($attributeSet['attributes'] as $attribute) : ?>
											<li>
												<strong><?php echo $attribute['title']; ?>:</strong> <?php echo $attribute['description']; ?>
											</li>
										<?php endforeach; ?>
									</ul>
								</div>
							</div>
						</div>
					<?php endforeach; ?>
				</div>
			</div>
		<?php endif; ?>
	</div>
</section>

<!-- Options -->
<section id="options" class="py-5">
	<div class="container">
		<?php if (!empty($this->optionSets)) : ?>
			<div class="card card-body">
				<?php foreach ($this->optionSets as $optionSet) : ?>
					<h5><?php echo $optionSet['title']; ?></h5>
					<ul>
						<?php foreach ($optionSet['options'] as $option) : ?>
							<li><strong><?php echo $option['title']; ?>:</strong>
								<?php if ($option['description']) : ?>
									<?php echo $option['description']; ?>
								<?php else : ?>
									<span>bereits enthalten</span>
								<?php endif; ?>
							</li>
						<?php endforeach; ?>
					</ul>
				<?php endforeach; ?>
			</div>
		<?php endif; ?>
	</div>
</section>

<?php $categoryImages = $this->categoryImages; ?>
<?php //if(count($categoryImages)) : ?>
	<?php foreach ($categoryImages as $image) : ?>
		<?php if ($image['type'] == 'download') : ?>
			<?php $downloads = true; ?>
		<?php endif; ?>
	<?php endforeach; ?>
<?php //endif; ?>
<?php $parentCategoryImages = $this->parentCategoryImages; ?>
<?php //if(count($parentCategoryImages)) : ?>
	<?php foreach ($parentCategoryImages as $image) : ?>
		<?php if ($image['type'] == 'download') : ?>
			<?php $downloads = true; ?>
		<?php endif; ?>
	<?php endforeach; ?>
<?php //endif; ?>

<!-- Downloads -->
<?php if(isset($categoryImages)) : ?>
	<section id="downloads" class="py-5">
		<div class="container">
			<?php if (!empty($this->item['downloads']) || $downloads) : ?>
			<h2 class="text-center mb-4"><?php echo $this->translate('SHOPS_DOWNLOADS'); ?></h2>
				<div class="card card-body">
					<ul>
						<?php foreach ($categoryImages as $file) : ?>
							<?php if (($file['type'] ?? null) === 'download') : ?>
								<li>
									<a href="<?php echo $this->baseUrl(); ?>/media/downloads/<?php echo $this->escape($file['url']); ?>" target="_blank">
										<?php echo $this->escape($file['title']); ?></a>
								</li>
							<?php endif; ?>
						<?php endforeach; ?>
						<?php foreach ($parentCategoryImages as $file) : ?>
							<?php if (($file['type'] ?? null) === 'download') : ?>
								<li>
									<a href="<?php echo $this->baseUrl(); ?>/media/downloads/<?php echo $this->escape($file['url']); ?>" target="_blank">
										<?php echo $this->escape($file['title']); ?></a>
								</li>
							<?php endif; ?>
						<?php endforeach; ?>
						<?php
						if (!empty($this->item['downloads'])) {
							// Split the download string into language and file name
							list($lang, $filePath) = explode('|', $this->item['downloads']);
							// Extract just the filename from the file path
							$fileName = basename($filePath);

							// Full server path to the file
							$serverFilePath = BASE_PATH . '/media/' . $this->escape($this->imagePath) . '/downloads/' . $filePath;

							// Check if the file exists
							if (file_exists($serverFilePath)) {
								// Extract just the filename from the file path
								$fileName = basename($filePath);
							?>
								<li>
									<a href="<?php echo $this->baseUrl(); ?>/media/downloads/<?php echo $this->escape($filePath); ?>" target="_blank">
										<?php echo $this->escape($fileName); ?></a>
									(<?php echo strtoupper($lang); ?>)
								</li>
							<?php } ?>
						<?php } ?>
					</ul>
				</div>
			<?php endif; ?>
		</div>
	</section>
<?php endif; ?>

<!-- Inquiry -->
<?php if($this->siteContext->hasFeature('inquiry')) : ?>
	<section id="inquiry" class="py-5">
		<div class="container">
			<h2 class="text-center mb-4"><?php echo $this->translate('SHOPS_SEND_INQUIRY'); ?></h2>
			<div class="card card-body">
				<?php echo $this->ContactForm($this->translate('SHOPS_INQUIRY_FORM').' '.$this->item['title'].' '.$this->item['sku']); ?>
			</div>
		</div>
	</section>
<?php endif; ?>

<script>
	document.addEventListener('DOMContentLoaded', function () {
		$('#carouselExampleControls').on('slid.bs.carousel', function () {
			var activeImage = $(this).find('.carousel-item.active img').get(0);
			if (activeImage) $('#mainImage').attr('src', activeImage.src);
		});
	});
</script>
