<?php

$title = trim((string)($this->data['title'] ?? ''));
$contactInfo = trim((string)($this->shop['contact'] ?? ''));

if (!$this->siteContext instanceof DEEC_Site_Context || !$this->siteContext->hasFeature('contact') || !$this->contact) {
	return;
}

$contactForm = $this->ContactForm($this->translate('SHOPS_CONTACT_FORM'));
?>

<section class="dw-site-block dw-site-block--contact">
	<div class="container">
		<?php if($title !== '') : ?>
			<h2 class="text-center mb-4"><?php echo $this->escape($title); ?></h2>
		<?php endif; ?>

		<div class="row">
			<?php if($contactInfo !== '') : ?>
				<div class="col-md-6">
					<?php echo $contactInfo; ?>
				</div>
			<?php endif; ?>

			<div class="<?php echo $contactInfo !== '' ? 'col-md-6' : 'col-12'; ?>">
				<?php echo $contactForm; ?>
			</div>
		</div>
	</div>
</section>
