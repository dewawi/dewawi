<?php

$eyebrow = trim((string)($this->data['eyebrow'] ?? ''));
$title = trim((string)($this->data['title'] ?? ''));
$text = trim((string)($this->data['text'] ?? ''));
$image = trim((string)($this->data['image'] ?? ''));
$imageAlt = trim((string)($this->data['imagealt'] ?? ''));
$buttonLabel = trim((string)($this->data['buttonlabel'] ?? ''));
$buttonUrl = trim((string)($this->data['buttonurl'] ?? ''));

if ($buttonUrl !== '' && preg_match('~^[a-z][a-z0-9+.-]*:~i', $buttonUrl) && !preg_match('~^(https?|mailto|tel):~i', $buttonUrl)) {
	$buttonUrl = '';
}
?>

<article class="dw-site-card<?php echo $image !== '' ? ' has-image' : ''; ?>">
	<?php if($image !== '') : ?>
		<div class="dw-site-card__media">
			<img src="<?php echo $this->escape($image); ?>" alt="<?php echo $this->escape($imageAlt); ?>">
		</div>
	<?php endif; ?>

	<div class="dw-site-card__content">
		<?php if($eyebrow !== '') : ?>
			<div class="dw-site-card__eyebrow"><?php echo $this->escape($eyebrow); ?></div>
		<?php endif; ?>

		<?php if($title !== '') : ?>
			<h3><?php echo $this->escape($title); ?></h3>
		<?php endif; ?>

		<?php if($text !== '') : ?>
			<div class="dw-site-card__text"><?php echo $text; ?></div>
		<?php endif; ?>

		<?php if($buttonLabel !== '' && $buttonUrl !== '') : ?>
			<a class="dw-site-card__link" href="<?php echo $this->escape($buttonUrl); ?>">
				<?php echo $this->escape($buttonLabel); ?>
			</a>
		<?php endif; ?>
	</div>
</article>
