<?php

$title = trim((string)($this->page['title'] ?? ''));
$metaTitle = trim((string)($this->page['metatitle'] ?? ''));
$metaDescription = trim((string)($this->page['metadescription'] ?? ''));
$content = DEEC_Filter::removeEmptyHeadings((string)($this->page['content'] ?? ''));

$this->title = $title;
$descriptionSource = $metaDescription !== '' ? $metaDescription : trim(html_entity_decode(strip_tags($content), ENT_QUOTES | ENT_HTML5, 'UTF-8'));
$this->SiteMetadata([
	'title' => $metaTitle !== '' ? $metaTitle : $title,
	'description' => $descriptionSource,
]);

$contentHasH1 = preg_match('/<h1\b/i', $content) === 1;
$contact = $this->siteContext->hasFeature('contact') ? $this->ContactForm($this->translate('SHOPS_CONTACT_FORM')) : '';
$content = str_replace('{contact}', $contact, $content);

$pageblocks = is_array($this->pageblocks ?? null) ? $this->pageblocks : [];
$hasHero = false;

foreach ($pageblocks as $pageblock) {
	$data = json_decode((string)($pageblock['data'] ?? ''), true);
	if (($pageblock['type'] ?? '') === 'hero' && is_array($data) && trim((string)($data['title'] ?? '')) !== '') {
		$hasHero = true;
		break;
	}
}
?>

<?php if (!$hasHero && !$contentHasH1 && $title !== ''): ?>
	<div class="container pt-5">
		<h1><?php echo $this->escape($title); ?></h1>
	</div>
<?php endif; ?>

<?php if ($pageblocks): ?>
	<?php echo $this->RenderPageBlocks($pageblocks, !$contentHasH1); ?>
<?php endif; ?>

<?php if (trim($content) !== ''): ?>
	<section class="py-5">
		<div class="container">
			<?php echo $content; ?>
		</div>
	</section>
<?php endif; ?>
