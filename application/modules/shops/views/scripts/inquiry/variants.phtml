				<?php elseif($option['included']): ?>Im Variantenpreis enthalten<?= $option['catalog_price'] === 0.0 ? ' (kostenlose Ausstattung)' : ''; ?>
				<?php elseif($option['status'] === 'priced'): ?>Zusätzlich <?= number_format($option['price'], 2, ',', '.'); ?> <?= $this->escape($option['currency']); ?> netto je <?= $this->escape($option['uom']); ?> (Menge <?= $this->escape((string)$option['quantity']); ?>)
				<?php else: ?>Manuelle Preis- und Verfügbarkeitsprüfung erforderlich<?php endif; ?>
			</li>
		<?php endforeach; ?></ul>
	</div>
	<?php endif; ?>
	<?php if(($selection['commercial']['pricing_status'] ?? '') === 'complete'): $pricing = $selection['commercial']; ?>
	<div class="variant-pricing">
		<p>Gespeicherter Variantenpreis: <?= number_format($pricing['positions'][0]['price'], 2, ',', '.'); ?> <?= $this->escape($pricing['currency']); ?> netto je <?= $this->escape($pricing['positions'][0]['uom']); ?><?= $pricing['positions'][0]['price_source'] === 'item.specialprice' ? ' (Sonderpreis)' : ''; ?></p>
		<p>Unverbindliche Summe der Ausstattung: <?= number_format($pricing['totals']['subtotal'], 2, ',', '.'); ?> <?= $this->escape($pricing['currency']); ?> netto; <?= number_format($pricing['totals']['total'], 2, ',', '.'); ?> <?= $this->escape($pricing['currency']); ?> einschließlich hinterlegter Steuern.</p>
		<p>Lieferland, Versand, Verfügbarkeit und sämtliche technischen Anforderungen sind noch zu prüfen.</p>
