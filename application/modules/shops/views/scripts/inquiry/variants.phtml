<section class="inquiry-variants inquiry-catalog" aria-label="Variantenkonfiguration" data-variant-field="<?= $this->escape($selection['variant_field']); ?>">
	<h3>Varianten und Ausstattung</h3>
	<p>Die Auswahl vorhandener Varianten bestätigt keine technische Eignung. Ihre Anfrage wird technisch und kaufmännisch manuell geprüft. Es wird kein automatisches Angebot erstellt.</p>
	<?php if($selection['base']): ?><h4><?= $this->escape($selection['base']['sku'].' – '.$selection['base']['title']); ?></h4><?php endif; ?>
	<ul class="variant-review-reasons" role="status">
	<?php foreach($selection['reasons'] as $reason): if(!isset($messages[$reason])) continue; ?>
		<li><?= $this->escape($messages[$reason]); ?></li>
	<?php endforeach; ?>
	</ul>
	<div class="inquiry-catalog-items">
	<?php foreach($selection['candidates'] as $variant): ?>
		<article class="inquiry-catalog-item">
			<h4><?= $this->escape($variant['sku'].' – '.$variant['title']); ?></h4>
			<p>Hinterlegte Ausstattung: <?= $this->escape(implode(', ', $variant['option_labels']) ?: 'Keine eindeutige Zuordnung'); ?></p>
			<?php if($selection['editable']): ?>
			<button type="button" class="btn btn-outline-primary select-inquiry-variant" aria-pressed="<?= ($selection['selected']['itemid'] ?? null) === $variant['itemid'] ? 'true' : 'false'; ?>" data-variantid="<?= $variant['itemid']; ?>" data-field-values="<?= $this->escape(json_encode($variant['field_values'])); ?>"<?= !$variant['configurable'] ? ' disabled' : ''; ?>>Diese Variante konfigurieren</button>
			<?php endif; ?>
		</article>
	<?php endforeach; ?>
	</div>
	<p class="variant-pending" aria-live="polite"></p>
	<?php if($selection['selected']): ?>
	<div class="variant-current-selection">
		<h4>Zur Prüfung vorgemerkt: <?= $this->escape($selection['selected']['sku'].' – '.$selection['selected']['title']); ?></h4>
		<ul><?php foreach($selection['options'] as $option): ?>
			<li><?= $this->escape($option['title']); ?>:
				<?php if($option['status'] === 'unavailable'): ?>Nicht verfügbar
