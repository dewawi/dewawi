<?php
$selection = $this->selection;
$statuses = ['matched' => $this->translate('SHOPS_CATALOG_MATCHED'), 'not_matched' => $this->translate('SHOPS_CATALOG_NOT_MATCHED'), 'missing_attribute' => $this->translate('SHOPS_CATALOG_ATTRIBUTE_MISSING'), 'ambiguous_attribute' => $this->translate('SHOPS_CATALOG_ATTRIBUTE_AMBIGUOUS'), 'unit_mismatch' => $this->translate('SHOPS_CATALOG_UNIT_MISMATCH'), 'invalid_attribute' => $this->translate('SHOPS_CATALOG_ATTRIBUTE_INVALID')];
?>
<section class="inquiry-catalog" aria-label="<?= $this->escape($this->translate('SHOPS_CATALOG_TITLE')); ?>">
	<h3><?php echo $this->escape($this->translate('SHOPS_CATALOG_HEADING')); ?></h3>
	<p><?php echo $this->escape($this->translate('SHOPS_CATALOG_REVIEW')); ?></p>
	<?php if(in_array('catalog_inputs_incomplete', $selection['reasons'], true)): ?>
		<p role="status"><?php echo $this->escape($this->translate('SHOPS_CATALOG_INPUTS_MISSING')); ?></p>
		<ul><?php foreach($selection['conditions'] as $condition): if(!in_array($condition['status'], ['missing_input', 'invalid_input'], true)) continue; ?>
			<li><?= $this->escape($condition['label']); ?>: <?= $condition['status'] === 'missing_input' ? $this->translate('SHOPS_CATALOG_INPUT_MISSING') : $this->translate('SHOPS_CATALOG_INPUT_INVALID'); ?></li>
		<?php endforeach; ?></ul>
	<?php elseif(in_array('catalog_unavailable', $selection['reasons'], true) || in_array('catalog_category_unavailable', $selection['reasons'], true) || in_array('catalog_attribute_limit', $selection['reasons'], true)): ?>
		<p role="status"><?php echo $this->escape($this->translate('SHOPS_CATALOG_UNAVAILABLE')); ?></p>
	<?php elseif(!$selection['candidates']): ?>
		<p role="status"><?= $this->escape($this->translate($selection['has_more'] ? 'SHOPS_CATALOG_PARTIAL_NO_MATCH' : 'SHOPS_CATALOG_NO_MATCH')); ?></p>
	<?php endif; ?>
	<?php if($selection['has_more']): ?>
		<p role="status"><?php echo $this->escape($this->translate('SHOPS_CATALOG_LIMITED')); ?></p>
	<?php endif; ?>
	<div class="inquiry-catalog-items">
	<?php foreach($selection['candidates'] as $item): ?>
		<article class="inquiry-catalog-item">
			<h4><?= $this->escape($item['sku']); ?> – <?= $this->escape($item['title']); ?></h4>
			<?php if(!empty($item['images'][0]['url'])) echo $this->SiteImage('/media/images/'.$item['images'][0]['url'], $item['images'][0]['title'] ?: $item['title'], ['class' => 'inquiry-catalog-image', 'sizes' => '(max-width: 767.98px) 100vw, 50vw']); ?>
			<ul>
			<?php foreach($item['conditions'] as $condition): if($condition['status'] === 'inactive') continue; ?>
				<li><strong><?= $this->escape($condition['label']); ?>:</strong> <?= $this->escape((string)($condition['actual'] ?? '')); ?> <?= $this->escape($condition['unit']); ?>
					(<?= $this->escape($statuses[$condition['status']]); ?>;
					Anforderung <?= $this->escape(['eq' => '=', 'gte' => '≥', 'lte' => '≤'][$condition['operator']]); ?> <?= $this->escape(implode(' / ', $condition['expected'])); ?> <?= $this->escape($condition['unit']); ?>)</li>
			<?php endforeach; ?>
			</ul>
			<p><?php echo $this->escape($this->translate('SHOPS_CATALOG_REVIEW_PENDING')); ?></p>
			<button type="button" class="btn btn-outline-primary select-catalog-suggestion" aria-pressed="false" data-item-field="<?= $this->escape($selection['item_field']); ?>" data-itemid="<?= (int)$item['itemid']; ?>" data-sku="<?= $this->escape($item['sku']); ?>" data-title="<?= $this->escape($item['title']); ?>"><?php echo $this->escape($this->translate('SHOPS_CATALOG_SELECT')); ?></button>
		</article>
	<?php endforeach; ?>
	</div>
	<p class="inquiry-catalog-choice" aria-live="polite"></p>
	<button type="button" class="btn btn-outline-secondary clear-catalog-suggestion" data-item-field="<?= $this->escape($selection['item_field']); ?>" data-itemid="" data-sku="" data-title=""><?php echo $this->escape($this->translate('SHOPS_CATALOG_SKIP')); ?></button>
	<?php if($selection['summary']): ?>
	<details class="inquiry-catalog-diagnostics">
		<summary><?php echo $this->escape($this->translate('SHOPS_CATALOG_REJECTED')); ?></summary>
		<p><?php echo $this->escape($this->translate('SHOPS_CATALOG_REJECTED_NOTE')); ?></p>
		<?php foreach($selection['rejected'] as $item): ?>
			<p><strong><?= $this->escape($item['sku']); ?> – <?= $this->escape($item['title']); ?></strong></p>
			<ul><?php foreach($item['conditions'] as $condition): if($condition['status'] === 'inactive') continue; ?>
				<li><?= $this->escape($condition['label']); ?>: <?= $this->escape($statuses[$condition['status']]); ?></li>
			<?php endforeach; ?></ul>
		<?php endforeach; ?>
	</details>
	<?php endif; ?>
</section>
