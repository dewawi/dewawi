<?php
$this->title = $this->tag['title'];
$this->headTitle($this->title);
$metaDescription = trim(html_entity_decode(strip_tags((string)($this->tag['description'] ?? '')), ENT_QUOTES | ENT_HTML5, 'UTF-8'));
if ($metaDescription !== '') $this->headMeta()->setName('description', mb_substr($metaDescription, 0, 160, 'UTF-8'));
$hasHeader = !empty($this->tag['header']);
?>

<?php if($hasHeader) : ?>
	<section id="header" style="position: relative;">
		<?php echo $this->tag['header']; ?>
		<div class="header-text">
			<h1 class="text-center text-white"><?php echo $this->escape($this->tag['title']); ?></h1>
		</div>
	</section>
<?php endif; ?>

	<section id="subcategories" class="py-5">
		<div class="container">
			<?php if($hasHeader) : ?>
				<h2 class="text-center mb-4"><?php echo $this->escape($this->tag['title']); ?></h2>
			<?php else : ?>
				<h1 class="text-center mb-4"><?php echo $this->escape($this->tag['title']); ?></h1>
			<?php endif; ?>
			<div class="row">
				<div class="text-center col-md-12 mb-4">
					<?php echo $this->tag['description']; ?>
				</div>
			</div>
			<div class="row">
				<div class="text-center col-md-12 mb-4">
					<h3 class="text-center mb-4">Relevante Produkte und Lösungen (<?php echo $this->tag['title']; ?>)</h3>
				</div>
			</div>
			<div class="row">
				<?php if($this->categories) : ?>
					<?php foreach($this->categories as $category) : ?>
						<?php foreach($this->tagEntities as $tagentity) : ?>
							<?php if($tagentity['entityid'] == $category['id']) : ?>
								<?php echo $this->RenderCategory($category); ?>
							<?php endif; ?>
						<?php endforeach; ?>
					<?php endforeach; ?>
				<?php endif; ?>
			</div>
		</div>
	</section>

<section id="footer">
	<div class="container">
		<div class="row">
			<?php echo $this->tag['footer']; ?>
		</div>
	</div>
</section>
