<?php
$order = $this->order;
$snapshot = $order['snapshot_data'];
$unknown = $this->translate('SHOPS_ORDER_UNKNOWN');
$t = fn(string $key): string => $this->escape($this->translate($key));
$money = fn($value): string => $value === null ? $this->escape($unknown) : $this->escape(number_format((float)$value, 2, ',', '.') . ' ' . ($order['currency'] ?: $unknown));
$url = fn(string $action): string => $this->url(['module' => 'shops', 'controller' => 'order', 'action' => $action, 'id' => (int)$order['id']], null, true);
$this->title = $this->translate('SHOPS_ORDER_ID') . ' ' . $order['orderid'];
$this->headTitle($this->title);
echo $this->Messages();
?>
<div class="dw-card">
	<h2><?php echo $this->escape($this->title); ?></h2>
	<dl class="view">
		<dt><?php echo $t('SHOPS_ORDER_DATE'); ?></dt><dd><?php echo $this->escape($order['orderdate'] ?: $unknown); ?> · <?php echo $this->escape($order['created'] ?: $unknown); ?></dd>
		<dt><?php echo $t('SHOPS_ORDER_SHOP'); ?></dt><dd><?php echo $this->escape($snapshot['shop']['title'] ?? $unknown); ?> (#<?php echo $this->escape($order['shopid']); ?>)</dd>
		<dt><?php echo $t('SHOPS_ORDER_STATUS'); ?></dt><dd><?php echo $t(Shops_Model_DbTable_Order::STATUSES[$order['status'] ?? ''] ?? 'SHOPS_ORDER_UNKNOWN'); ?></dd>
		<dt><?php echo $t('SHOPS_ORDER_EMAIL'); ?></dt><dd><?php echo $this->escape($snapshot['email'] ?? $unknown); ?></dd>
	</dl>
	<div class="row">
		<?php foreach (['billing' => 'SHOPS_ORDER_BILLING', 'shipping' => 'SHOPS_ORDER_SHIPPING'] as $type => $label) : ?>
			<div class="col-sm-12 col-lg-6">
				<h3><?php echo $t($label); ?></h3>
				<address>
					<?php if (isset($snapshot[$type])) : ?>
						<?php foreach (['company', 'name', 'department', 'street'] as $field) : ?>
							<?php if (($snapshot[$type][$field] ?? '') !== '') echo nl2br($this->escape($snapshot[$type][$field])) . '<br>'; ?>
						<?php endforeach; ?>
						<?php echo $this->escape(trim(($snapshot[$type]['postcode'] ?? '') . ' ' . ($snapshot[$type]['city'] ?? ''))); ?><br>
						<?php echo $this->escape($snapshot[$type]['country'] ?? ''); ?><br>
						<?php echo $t('SHOPS_ORDER_PHONE'); ?>: <?php echo $this->escape($snapshot[$type]['phone'] ?? ''); ?>
					<?php else : echo $this->escape($unknown); endif; ?>
				</address>
			</div>
		<?php endforeach; ?>
	</div>
	<h3><?php echo $t('SHOPS_ORDER_POSITIONS'); ?></h3>
	<div class="dw-table-wrap">
		<table class="dw-table">
			<thead><tr><?php foreach (['SHOPS_ORDER_ITEM', 'SHOPS_ORDER_QUANTITY', 'SHOPS_ORDER_UNIT_PRICE', 'SHOPS_ORDER_NET', 'SHOPS_ORDER_TAX_RATE'] as $label) : ?><th><?php echo $t($label); ?></th><?php endforeach; ?></tr></thead>
			<tbody>
				<?php foreach ($order['positions'] as $position) : $row = $position['snapshot_data']; ?>
					<tr>
						<td><?php echo $this->escape($row['sku'] ?? $unknown); ?><br><strong><?php echo $this->escape($row['title'] ?? $unknown); ?></strong><br><?php echo nl2br($this->escape($row['description'] ?? '')); ?><br>#<?php echo (int)$position['itemid']; ?></td>
						<td><?php echo $this->escape($position['quantity'] ?? $unknown); ?> <?php echo $this->escape($row['uom'] ?? ''); ?></td>
						<td><?php echo $money($position['price']); ?></td><td><?php echo $money($position['total']); ?></td>
						<td><?php echo isset($row['taxrate']) ? $this->escape((string)$row['taxrate']) . ' %' : $this->escape($unknown); ?></td>
					</tr>
				<?php endforeach; ?>
			</tbody>
		</table>
	</div>
	<dl class="view">
		<?php foreach (['total' => 'SHOPS_ORDER_NET', 'taxes' => 'SHOPS_ORDER_TAX', 'grosstotal' => 'SHOPS_ORDER_GROSS'] as $field => $label) : ?>
			<dt><?php echo $t($label); ?></dt><dd><?php echo $money($order[$field]); ?></dd>
		<?php endforeach; ?>
	</dl>
	<h3><?php echo $t('SHOPS_ORDER_NOTES'); ?></h3>
	<p><?php echo nl2br($this->escape($snapshot['message'] ?? $unknown)); ?></p>
	<?php if ($this->salesorder) : ?>
		<p><a class="dw-btn dw-btn--primary" href="<?php echo $this->escape($this->url(['module' => 'sales', 'controller' => 'salesorder', 'action' => 'edit', 'id' => (int)$this->salesorder['id']], null, true)); ?>"><?php echo $t('SHOPS_ORDER_ERP'); ?> #<?php echo (int)$this->salesorder['id']; ?></a></p>
	<?php elseif (!empty($order['salesorderid'])) : ?>
		<p><?php echo $t('SHOPS_ORDER_LINK_UNAVAILABLE'); ?></p>
	<?php endif; ?>
</div>

<?php if ($this->permissions['edit'] && !in_array($order['status'], ['completed', 'cancelled'], true)) : ?>
	<form method="post" action="<?php echo $this->escape($url('state')); ?>" class="dw-card">
		<input type="hidden" name="csrf" value="<?php echo $this->escape($this->csrf); ?>">
		<label for="order-status"><?php echo $t('SHOPS_ORDER_STATUS'); ?></label>
		<select id="order-status" name="status">
			<?php foreach (Shops_Model_DbTable_Order::STATUSES as $value => $label) : if ($value === 'new' || $value === 'transferred' || ($value === 'in_progress' && !empty($order['salesorderid']))) continue; ?>
				<option value="<?php echo $this->escape($value); ?>"<?php echo $value === $order['status'] ? ' selected' : ''; ?>><?php echo $t($label); ?></option>
			<?php endforeach; ?>
		</select>
		<button type="submit" class="dw-btn dw-btn--primary"><?php echo $t('SHOPS_ORDER_SAVE_STATUS'); ?></button>
	</form>
<?php endif; ?>

<?php if ($this->problems) : ?>
	<div class="dw-card"><h3><?php echo $t('SHOPS_ORDER_REVIEW_REQUIRED'); ?></h3><ul><?php foreach ($this->problems as $problem) : ?><li><?php echo $t($problem); ?></li><?php endforeach; ?></ul></div>
<?php elseif ($this->canConvert && empty($order['salesorderid']) && !in_array($order['status'], ['completed', 'cancelled'], true)) : ?>
	<section class="dw-card">
		<h3><?php echo $t('SHOPS_ORDER_CREATE_ERP'); ?></h3>
		<p><?php echo $t('SHOPS_ORDER_CONTACT_NOTICE'); ?></p>
		<form method="get" action="<?php echo $this->escape($url('view')); ?>">
			<label for="order-contact-query"><?php echo $t('SHOPS_ORDER_CONTACT_SEARCH'); ?></label>
			<input id="order-contact-query" name="contactquery" maxlength="100" value="<?php echo $this->escape($this->contactquery); ?>">
			<button type="submit" class="dw-btn"><?php echo $t('SHOPS_ORDER_SEARCH'); ?></button>
		</form>
		<p><?php echo $t('SHOPS_ORDER_CONVERSION_NOTICE'); ?></p>
		<form method="post" action="<?php echo $this->escape($url('createsalesorder')); ?>">
			<input type="hidden" name="csrf" value="<?php echo $this->escape($this->csrf); ?>">
			<label for="order-contact"><?php echo $t('SHOPS_ORDER_CUSTOMER'); ?></label>
			<select id="order-contact" name="contactid" required><option value=""><?php echo $t('SHOPS_ORDER_SELECT_CONTACT'); ?></option>
				<?php foreach ($this->contacts as $contact) : ?><option value="<?php echo (int)$contact['id']; ?>"><?php echo $this->escape($contact['label'] . ($contact['subtitle'] !== '' ? ' · ' . $contact['subtitle'] : '')); ?></option><?php endforeach; ?>
			</select>
			<button type="submit" class="dw-btn dw-btn--primary"><?php echo $t('SHOPS_ORDER_CREATE_ERP'); ?></button>
		</form>
		<?php if ($this->canCreateContact) : ?><p><a href="<?php echo $this->escape($this->url(['module' => 'contacts', 'controller' => 'contact', 'action' => 'add'], null, true)); ?>" target="_blank" rel="noopener"><?php echo $t('SHOPS_ORDER_NEW_CONTACT'); ?></a></p><?php endif; ?>
	</section>
<?php endif; ?>

<?php if ($order['history']) : ?>
	<section class="dw-card"><h3><?php echo $t('SHOPS_ORDER_HISTORY'); ?></h3>
		<ul><?php foreach ($order['history'] as $event) : ?><li><?php echo $this->escape($event['created'] . ' · ' . ($event['createdbyname'] ?: '#' . $event['createdby'])); ?>: <?php echo $t(Shops_Model_DbTable_Order::STATUSES[$event['oldstatus'] ?? ''] ?? 'SHOPS_ORDER_UNKNOWN'); ?> → <?php echo $t(Shops_Model_DbTable_Order::STATUSES[$event['newstatus']]); ?></li><?php endforeach; ?></ul>
	</section>
<?php endif; ?>
