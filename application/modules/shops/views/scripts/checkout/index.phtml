<section id="checkout" class="py-5">
	<div class="container">
		<h2><?php echo $this->translate('SHOPS_ORDER_FORM'); ?></h2>
		<p><a href="<?php echo $this->escape($this->url([], 'cart')); ?>"><?php echo $this->translate('SHOPS_SHOPPING_CART_EDIT'); ?></a></p>
		<div class="row">
			<div class="col-md-8 mb-4">
				<?php if ($this->items) echo $this->CheckoutForm($this->translate('SHOPS_ORDER_FORM')); ?>
			</div>
			<div class="col-md-4 mb-4">
				<h2><?php echo $this->translate('SHOPS_SHOPPING_CART'); ?></h2>
				<div class="cart-wrapper">
					<?php if ($this->items) : ?>
						<?php foreach ($this->items as $item) : ?>
							<div class="cart-item">
								<strong><?php echo $this->escape($item['title']); ?></strong>
								<div class="text-muted"><?php echo $this->escape($item['sku']); ?></div>
								<div><?php echo $this->translate('SHOPS_PRICE'); ?>: <?php echo $item['price']; ?></div>
								<div><?php echo $this->translate('SHOPS_QUANTITY'); ?>: <?php echo $this->escape($item['quantity'] . ' ' . ($item['uom'] ?? '')); ?></div>
								<div><?php echo $this->translate('SHOPS_TOTAL'); ?>: <?php echo $item['total']; ?></div>
							</div>
						<?php endforeach; ?>
						<p class="cart-summary"><?php echo $this->translate('SHOPS_TOTAL'); ?>: <?php echo $this->total; ?></p>
					<?php else : ?>
						<p><?php echo $this->translate('SHOPS_SHOPPING_CART_EMPTY'); ?></p>
					<?php endif; ?>
					<p class="small mt-3"><?php echo $this->translate('SHOPS_CART_NET_NOTICE'); ?>
						<?php $shippingPage = $this->PageByType('shipping'); ?>
						<?php if ($shippingPage) : ?><a href="<?php echo $this->escape($this->SlugUrl('page', (int)$shippingPage['id'])); ?>"><?php echo $this->translate('SHOPS_SHIPPING_COSTS'); ?></a><?php endif; ?>
					</p>
				</div>
			</div>
		</div>
	</div>
</section>
