<section id="checkout-page" class="py-5">
	<div class="container">
		<h1><?php echo $this->translate('SHOPS_ORDER_FORM'); ?></h1>
		<p><a href="<?php echo $this->escape($this->url([], 'cart')); ?>"><?php echo $this->translate('SHOPS_SHOPPING_CART_EDIT'); ?></a></p>
		<?php if ($this->checkoutError) : ?><div class="alert alert-danger" role="alert"><?php echo $this->escape($this->checkoutError); ?></div><?php endif; ?>
		<?php if ($this->positions) : ?>
			<div class="row">
				<div class="col-lg-7 mb-4"><?php echo $this->CheckoutForm($this->translate('SHOPS_ORDER_FORM')); ?></div>
				<aside class="col-lg-5 mb-4" aria-label="<?php echo $this->escape($this->translate('SHOPS_ORDER_POSITIONS')); ?>">
					<h2><?php echo $this->translate('SHOPS_SHOPPING_CART'); ?></h2>
					<p data-checkout-recheck hidden><?php echo $this->translate('SHOPS_SHIPPING_RECHECK'); ?></p>
					<div class="cart-wrapper" data-checkout-summary><?php echo $this->partial('checkout/_summary.phtml', ['order' => $this->orderTotals, 'positions' => $this->positions]); ?></div>
				</aside>
			</div>
		<?php else : ?><p><?php echo $this->translate('SHOPS_SHOPPING_CART_EMPTY'); ?></p><?php endif; ?>
	</div>
</section>
