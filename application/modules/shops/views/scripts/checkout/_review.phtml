<?php $snapshot = Shops_Service_OrderSnapshot::decode($this->order['snapshot']); ?>
<h2 tabindex="-1" id="checkout-review-title"><?php echo $this->translate('SHOPS_CHECKOUT_REVIEW'); ?></h2>
<p><?php echo $this->translate('SHOPS_CHECKOUT_REVIEW_NOTE'); ?></p>
<?php echo $this->partial('checkout/_addresses.phtml', ['snapshot' => $snapshot]); ?>
<?php echo $this->partial('checkout/_summary.phtml', ['order' => $this->order, 'positions' => $this->positions]); ?>
<p><?php echo $this->translate('SHOPS_CHECKOUT_NO_PAYMENT'); ?></p>
<input type="hidden" name="review_token" value="<?php echo $this->escape($this->reviewToken); ?>">
<div class="dw-checkout-actions">
	<button class="btn btn-secondary" type="submit" name="checkout_edit" value="1" formnovalidate><?php echo $this->translate('SHOPS_CHECKOUT_EDIT'); ?></button>
	<?php $freight = $snapshot['freight'] ?? null; ?>
	<?php if (Shops_Service_OrderSnapshot::canOrder($this->order)) : ?>
		<button class="btn btn-success" type="submit" data-checkout-confirm><?php echo $this->translate('SHOPS_LABEL_ORDER'); ?></button>
	<?php elseif ($freight['status'] === 'quote_required' && $this->canRequestShipping) : ?>
		<button class="btn btn-primary" type="submit" name="checkout_quote" value="1"><?php echo $this->translate('SHOPS_SHIPPING_QUOTE_REQUEST'); ?></button>
	<?php elseif ($freight['status'] === 'quote_required') : ?>
		<p><?php echo $this->translate('SHOPS_SHIPPING_QUOTE_CONTACT'); ?></p>
		<?php if (DEEC_Filter::isValidEmail($this->contactEmail ?? '')) : ?>
			<p><a href="mailto:<?php echo $this->escape($this->contactEmail); ?>"><?php echo $this->escape($this->contactEmail); ?></a></p>
		<?php else : ?>
			<p><a href="<?php echo $this->escape($this->url([], 'shop_home')); ?>"><?php echo $this->translate('SHOPS_BACK_HOME'); ?></a></p>
		<?php endif; ?>
	<?php endif; ?>
</div>
