<?php $this->headTitle($this->translate('SHOPS_CHECKOUT')); ?>
<section id="success" class="py-5">
	<div class="container">
		<?php if ($this->order) : ?>
			<h1><?php echo $this->translate('SHOPS_ORDER_SUCCESS_TITLE'); ?></h1>
			<p><?php echo $this->translate('SHOPS_ORDER_RECEIVED'); ?></p>
			<p><strong><?php echo $this->translate('SHOPS_ORDER_NUMBER'); ?>: <?php echo $this->escape($this->order['orderid']); ?></strong></p>
			<p><?php echo $this->translate('SHOPS_CHECKOUT_NEXT_STEPS'); ?></p>
			<p><?php echo $this->translate('SHOPS_CHECKOUT_NO_PAYMENT'); ?></p>
			<?php if ($this->notificationSent === false) : ?><p role="status"><?php echo $this->translate('SHOPS_ORDER_EMAIL_FAILED'); ?></p><?php endif; ?>
			<?php $snapshot = Shops_Service_OrderSnapshot::decode($this->order['snapshot'] ?? null); ?>
			<?php if ($snapshot) : ?>
				<details class="mt-4"><summary><?php echo $this->translate('SHOPS_CHECKOUT_DETAILS'); ?></summary>
					<?php echo $this->partial('checkout/_addresses.phtml', ['snapshot' => $snapshot]); ?>
					<?php echo $this->partial('checkout/_summary.phtml', ['order' => $this->order, 'positions' => $this->positions]); ?>
				</details>
			<?php endif; ?>
		<?php else : ?>
			<h1><?php echo $this->translate('SHOPS_CHECKOUT_NO_RECEIPT'); ?></h1>
			<p><?php echo $this->translate('SHOPS_CHECKOUT_NO_RECEIPT_NOTE'); ?></p>
		<?php endif; ?>
		<p class="mt-4"><a href="<?php echo $this->escape($this->url([], 'shop_home')); ?>" class="btn btn-primary"><?php echo $this->translate('SHOPS_BACK_HOME'); ?></a></p>
	</div>
</section>
