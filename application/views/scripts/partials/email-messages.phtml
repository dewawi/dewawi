<?php
$uploadUrl = $this->baseUrl()
	. '/contacts/attachment/upload/cmodule/' . urlencode((string) $this->module)
	. '/ccontroller/' . urlencode((string) $this->controller)
	. '/id/' . (int) $this->id;
?>

<div id="output" style="display:none;"></div>

<div class="dw-email-composer">
	<?php $isCampaign = $this->mode === 'campaign'; ?>
	<form
		id="emailmessage"
		class="dw-email-composer__form"
		data-autosave="<?php echo $isCampaign ? 'true' : 'false'; ?>"
		method="post">

		<?php if($this->emailForm->getElement('feedback')) : ?>
			<?= $this->emailForm->renderElement('feedback'); ?>
		<?php endif; ?>

		<div class="dw-form-row">
			<div class="dw-field dw-field--col-8">
				<div class="dw-email-card">
					<div class="dw-form-row">
						<?php if(!$isCampaign) : ?>
							<?= $this->emailForm->renderElement('recipient'); ?>
						<?php endif; ?>

						<?= $this->emailForm->renderElement('cc'); ?>
						<?= $this->emailForm->renderElement('bcc'); ?>
						<?= $this->emailForm->renderElement('replyto'); ?>
						<?= $this->emailForm->renderElement('subject'); ?>

						<div class="dw-field dw-field--col-12">
							<label class="dw-label" for="attachments">
								<?= $this->translate('CONTACTS_ATTACHMENTS'); ?>
							</label>

							<div id="attachments" class="dw-attachment-list">
								<?php if (!empty($this->attachments)) : ?>
									<?php foreach ($this->attachments as $attachment) : ?>
										<?php
										$attachmentId = (string) ($attachment['selection'] ?? $attachment['id']);
										$domId = preg_replace('/[^a-zA-Z0-9_-]+/', '-', $attachmentId);
										$filename = (string) $attachment['filename'];
										$attachmentUrl = $this->baseUrl() . ($attachment['url'] ?? ('/contacts/attachment/download/id/' . rawurlencode($attachmentId)));
										?>
										<div id="attachment<?= $this->escape($domId); ?>" class="dw-attachment-item">
											<?php if(($attachment['available'] ?? true) !== false) : ?>
											<label class="dw-attachment-item__select">
												<input type="checkbox" value="<?= $this->escape($attachmentId); ?>" name="file[]"<?= $isCampaign ? '' : ' checked'; ?>>
												<span></span>
											</label>
											<?php endif; ?>

											<?php if(($attachment['available'] ?? true) !== false) : ?><a class="dw-attachment-item__link" href="<?= $attachmentUrl; ?>" target="_blank" rel="noopener"><?php else : ?><span class="dw-attachment-item__link"><?php endif; ?>
												<span class="dw-attachment-item__name"><?= $this->escape($filename); ?></span>
												<span class="dw-attachment-item__meta">(<?= $this->HumanFileSize($attachment['filesize']); ?>)</span>
											<?php if(($attachment['available'] ?? true) !== false) : ?></a><?php else : ?></span><?php endif; ?>
											<?php if(($attachment['available'] ?? true) === false) : ?><span class="dw-status-message dw-status-message--error"><?= $this->escape($this->translate('CONTACTS_DOCUMENT_FILE_MISSING')); ?></span><?php endif; ?>

											<?php if(($attachment['deletable'] ?? true) !== false) : ?><button
												type="button"
												class="dw-btn dw-btn--icon delete nolabel" aria-label="<?= $this->escape($this->translate('TOOLBAR_DELETE')); ?>"
												onclick="deleteAttachment('<?= $this->escape($attachmentId); ?>', deleteConfirm, 'attachment', 'contacts', this);">
												Delete
											</button><?php endif; ?>
										</div>
									<?php endforeach; ?>
								<?php else : ?>
									<div class="dw-attachment-list__empty">
										<?= $this->translate('CONTACTS_NO_ATTACHMENTS'); ?>
									</div>
								<?php endif; ?>
							</div>
						</div>

						<?= $this->emailForm->renderElement('body'); ?>

						<?php if(!$isCampaign) : ?>
							<div class="dw-field dw-field--col-12">
								<div class="dw-email-composer__actions">
									<button type="button" class="send dw-btn dw-btn--primary" onclick="sendMessage()">
										<?= $this->translate('EMAIL_SEND'); ?>
									</button>
								</div>
							</div>
						<?php endif; ?>
					</div>
				</div>
			</div>

			<div class="dw-field dw-field--col-4">
				<div class="dw-email-card">
					<h4 class="dw-email-card__title">
						<?= $this->translate('CONTACTS_ATTACHMENTS'); ?>
					</h4>

					<iframe
						src="<?= $uploadUrl; ?>"
						class="dw-email-upload-frame"
						title="Attachment upload"
						height="420"
					></iframe>
				</div>
			</div>
		</div>
	</form>

	<div id="emailmessages" class="dw-email-history"></div>
</div>
