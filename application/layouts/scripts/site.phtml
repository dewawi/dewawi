<?php

$shop = is_array($this->shop ?? null) ? $this->shop : [];
$categories = is_array($this->categories ?? null) ? $this->categories : [];
$menus = is_iterable($this->menus ?? null) ? $this->menus : [];
$menuitems = is_array($this->menuitems ?? null) ? $this->menuitems : [];

$language = str_replace('_', '-', (string)$this->siteContext->getLanguage());
$home = $this->controller === 'index' && $this->action === 'index';

$this->headMeta()->appendHttpEquiv('Content-Type', 'text/html;charset=utf-8');
$this->headTitle()->setSeparator(' - ');
$this->headTitle($shop['title'] ?? '');

echo $this->doctype();
?>
<html lang="<?php echo $this->escape($language); ?>">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<?php echo $this->headMeta(); ?>
	<?php echo $this->headTitle(); ?>
	<?php echo $this->headLink(); ?>
	<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
	<link rel="stylesheet" href="<?php echo $this->baseUrl(); ?>/css/shop.css">
</head>
<body>
	<header <?php if($home) echo 'class="home"' ?>>
		<nav class="navbar navbar-expand-lg navbar-light">
			<div class="container">
				<a class="navbar-brand" href="<?php echo $this->url(array(), 'shop_home'); ?>">
					<img src="<?php echo $this->baseUrl(); ?>/media/header/<?php echo $shop['logo'] ?? ''; ?>" alt="<?php echo $shop['title'] ?? ''; ?>" height="75">
				</a>
				<button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse" id="navbarNav">
					<ul class="navbar-nav ml-auto">
						<?php foreach($menus as $menu) : ?>
							<?php if($menu->position === 'header') : ?>
								<?php echo $this->RenderMenuItems($menuitems[$menu->id] ?? []); ?>
							<?php endif; ?>
						<?php endforeach; ?>

						<?php echo $this->RenderCategoryNavigation($categories); ?>

						<?php if($this->siteContext->hasFeature('cart')) : ?>
							<li class="nav-item">
								<a class="nav-link" href="<?php echo $this->url(array(), 'cart'); ?>" id="navbar-cart">
									🛒 <span id="cart-count" class="badge badge-danger"><?php echo $this->cart->getItemCount(); ?></span>
								</a>
							</li>
						<?php endif; ?>
					</ul>
				</div>
			</div>
		</nav>
		<?php if(!$home) : ?>
			<!-- Breadcrumbs -->
			<?php echo $this->Breadcrumbs(); ?>
		<?php endif; ?>
	</header>

	<?php echo $this->layout()->content; ?>

	<?php if($this->controller === 'category' && $this->siteContext->hasFeature('inquiry') && isset($this->category)) : ?>
		<section id="contact" class="jumbotron jumbotron-fluid py-5 mb-0">
			<div class="container">
				<h2 class="text-center mb-4"><?php echo $this->translate('SHOPS_INQUIRY_HEADING'); ?></h2>
				<div class="row">
					<div class="col-md-6">
						<?php echo $shop['contact'] ?? ''; ?>
					</div>
					<div class="col-md-6">
						<?php echo $this->ContactForm($this->translate('SHOPS_INQUIRY_FORM').' '.$this->category['title']); ?>
					</div>
				</div>
			</div>
		</section>
	<?php endif; ?>

	<footer class="py-4 bg-dark text-white">
		<div class="container text-center">
			<ul class="row-menu">
				<?php foreach($menus as $menu) : ?>
					<?php if($menu->position === 'footer') : ?>
						<?php echo $this->RenderMenuItems($menuitems[$menu->id] ?? []); ?>
					<?php endif; ?>
				<?php endforeach; ?>
			</ul>
			<p><?php echo $this->shop['copyright']; ?></p>
			<p><?php echo $this->shop['footer']; ?></p>
			<p><?php echo $this->translate('SHOPS_FOOTER_LEGAL_NOTICE'); ?></p>
			<p><?php echo $this->translate('SHOPS_FOOTER_COOKIE_NOTICE'); ?></p>
		</div>
	</footer>

	<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
	<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
	<script type="text/javascript" src="<?php echo $this->baseUrl(); ?>/js/shops.js"></script>
	<?php echo $shop['analytics'] ?? ''; ?>
</body>
</html>
