<?php

$shop = is_array($this->shop ?? null) ? $this->shop : [];
$categories = is_array($this->categories ?? null) ? $this->categories : [];
$menus = is_iterable($this->menus ?? null) ? $this->menus : [];
$menuitems = is_array($this->menuitems ?? null) ? $this->menuitems : [];

$language = str_replace('_', '-', (string)$this->siteContext->getLanguage());
$theme = $this->siteContext->getTheme();
$themeFile = BASE_PATH . '/css/themes/' . $theme . '.css';
$activeTheme = $theme !== 'default' && is_file($themeFile) ? $theme : 'default';
$home = $this->controller === 'index' && $this->action === 'index';
$hasAnalytics = $this->siteContext->hasAnalytics();
$analyticsConsent = $this->siteContext->getAnalyticsConsentState();
$analyticsAllowed = $this->siteContext->canLoadAnalytics();
$analyticsEventInterface = $this->siteContext->getAnalyticsEventInterface();
$conversionEvents = is_array($this->conversionEvents ?? null) ? $this->conversionEvents : [];
$consentReturn = (string)($_SERVER['REQUEST_URI'] ?? '/');

$headerNavigation = '';
$headerActions = '';

foreach ($menus as $menu) {
	$items = $menuitems[$menu->id] ?? [];

	if ($menu->position === 'header') {
		$headerNavigation .= $this->RenderMenuItems($items, 0, 'mega');
	} elseif ($menu->position === 'header-actions') {
		$headerActions .= $this->RenderMenuItems($items);
	}
}

if (!$this->siteContext->isIndexable()) $this->headMeta()->setName('robots', 'noindex, nofollow');
$siteMetadata = $this->SiteMetadata()->finalize();

echo $this->doctype();
?>
<html lang="<?php echo $this->escape($language); ?>">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<?php echo $this->headMeta(); ?>
	<?php echo $this->headTitle(); ?>
	<?php echo $this->headLink(); ?>
	<?php echo $siteMetadata->renderOrganization(); ?>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" integrity="sha384-xOolHFLEh07PJGoPkLv1IbcEPTNtaed2xpHsD9ESMhqIYd0nLMwNLD69Npy4HI+N" crossorigin="anonymous">
	<link rel="stylesheet" href="<?php echo $this->baseUrl(); ?>/css/shop.css">
	<?php if($activeTheme !== 'default') : ?>
		<link rel="stylesheet" href="<?php echo $this->baseUrl(); ?>/css/themes/<?php echo $this->escape($activeTheme); ?>.css">
	<?php endif; ?>
</head>
<body class="dw-theme-<?php echo $this->escape($activeTheme); ?>" data-theme="<?php echo $this->escape($activeTheme); ?>">
	<a class="dw-skip-link" href="#main-content"><?php echo $this->translate('SHOPS_SKIP_TO_CONTENT'); ?></a>
	<header class="dw-site-header<?php echo $home ? ' home' : ''; ?>">
		<nav class="navbar navbar-expand-xl navbar-light" aria-label="<?php echo $this->translate('SHOPS_MAIN_NAVIGATION'); ?>">
			<div class="container">
				<a class="navbar-brand" href="<?php echo $this->url(array(), 'shop_home'); ?>">
					<?php echo $this->SiteImage('/media/header/' . (string)($shop['logo'] ?? ''), (string)($shop['title'] ?? ''), ['loading' => false, 'sizes' => '280px']); ?>
				</a>
				<button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="<?php echo $this->translate('SHOPS_MENU_TOGGLE'); ?>">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse" id="navbarNav">
					<ul class="navbar-nav ml-auto dw-main-nav">
						<?php if($headerNavigation !== '') : ?>
							<?php echo $headerNavigation; ?>
						<?php else : ?>
							<?php echo $this->RenderCategoryNavigation($categories); ?>
						<?php endif; ?>
					</ul>

					<form class="dw-header-search" action="<?php echo $this->url([], 'search', true); ?>" method="get" role="search">
						<label class="sr-only" for="header-search-query"><?php echo $this->translate('SHOPS_SEARCH_LABEL'); ?></label>
						<div class="input-group">
							<input id="header-search-query" class="form-control" type="search" name="q" value="<?php echo $this->escape((string)($this->search['query'] ?? '')); ?>" placeholder="Was suchen Sie?" maxlength="100">
							<div class="input-group-append">
								<button class="btn btn-outline-secondary" type="submit">
									<span aria-hidden="true">&#128269;</span>
									<span class="sr-only"><?php echo $this->translate('SHOPS_SEARCH_SUBMIT'); ?></span>
								</button>
							</div>
						</div>
					</form>

					<?php if($headerActions !== '' || $this->siteContext->hasFeature('cart')) : ?>
						<ul class="navbar-nav dw-header-actions">
							<?php echo $headerActions; ?>

							<?php if($this->siteContext->hasFeature('cart')) : ?>
								<li class="nav-item">
									<a class="nav-link" href="<?php echo $this->url(array(), 'cart'); ?>" id="navbar-cart">
										<span aria-hidden="true">🛒</span><span class="sr-only"><?php echo $this->translate('SHOPS_SHOPPING_CART'); ?>: </span> <span id="cart-count" class="badge badge-danger" aria-live="polite" aria-atomic="true"><?php echo $this->cart->getItemCount(); ?></span>
									</a>
								</li>
							<?php endif; ?>
						</ul>
					<?php endif; ?>
				</div>
			</div>
		</nav>
		<?php if(!$home) : ?>
			<!-- Breadcrumbs -->
			<?php echo $this->Breadcrumbs(); ?>
		<?php endif; ?>
	</header>

	<main id="main-content" tabindex="-1">
		<?php echo $this->layout()->content; ?>

		<?php if($this->controller === 'category' && $this->siteContext->hasFeature('inquiry') && isset($this->category)) : ?>
			<section id="contact" class="jumbotron jumbotron-fluid py-5 mb-0">
				<div class="container">
					<h2 class="text-center mb-4"><?php echo $this->translate('SHOPS_INQUIRY_HEADING'); ?></h2>
					<div class="row">
						<div class="col-md-6">
							<?php echo $shop['contact'] ?? ''; ?>
						</div>
						<div class="col-md-6">
							<?php echo $this->ContactForm($this->translate('SHOPS_INQUIRY_FORM').' '.$this->category['title']); ?>
						</div>
					</div>
				</div>
			</section>
		<?php endif; ?>
	</main>

	<footer class="py-4 bg-dark text-white">
		<div class="container text-center">
			<nav aria-label="<?php echo $this->translate('SHOPS_FOOTER_NAVIGATION'); ?>">
				<ul class="row-menu">
					<?php foreach($menus as $menu) : ?>
						<?php if($menu->position === 'footer') : ?>
							<?php echo $this->RenderMenuItems($menuitems[$menu->id] ?? []); ?>
						<?php endif; ?>
					<?php endforeach; ?>
				</ul>
			</nav>
			<p><?php echo $this->shop['copyright']; ?></p>
			<p><?php echo $this->shop['footer']; ?></p>
			<p><?php echo $this->translate('SHOPS_FOOTER_LEGAL_NOTICE'); ?></p>
			<p><?php echo $this->translate('SHOPS_FOOTER_COOKIE_NOTICE'); ?></p>
			<?php if($hasAnalytics) : ?>
				<button class="btn btn-link text-white dw-consent-settings" type="button" data-consent-open aria-controls="site-consent-panel" aria-expanded="<?php echo $analyticsConsent === null ? 'true' : 'false'; ?>">
					<?php echo $this->translate('SHOPS_CONSENT_SETTINGS'); ?>
				</button>
			<?php endif; ?>
		</div>
	</footer>

	<?php if($hasAnalytics) : ?>
		<section id="site-consent-panel" class="dw-consent-panel" role="dialog" aria-modal="false" aria-labelledby="site-consent-title" aria-describedby="site-consent-description" tabindex="-1" data-consent-panel data-consent-state="<?php echo $this->escape((string)($analyticsConsent ?? 'unknown')); ?>"<?php echo $analyticsConsent === null ? ' data-consent-initial="true"' : ' hidden'; ?>>
			<div class="dw-consent-panel__content">
				<h2 id="site-consent-title" class="h5"><?php echo $this->translate('SHOPS_CONSENT_TITLE'); ?></h2>
				<p id="site-consent-description"><?php echo $this->translate('SHOPS_CONSENT_DESCRIPTION'); ?></p>
				<?php if($analyticsConsent !== null) : ?>
					<p class="dw-consent-panel__status" role="status">
						<?php echo $this->translate($analyticsConsent === 'accepted' ? 'SHOPS_CONSENT_STATUS_ACCEPTED' : 'SHOPS_CONSENT_STATUS_DECLINED'); ?>
					</p>
				<?php endif; ?>
				<form action="<?php echo $this->url([], 'site_consent', true); ?>" method="post">
					<input type="hidden" name="return" value="<?php echo $this->escape($consentReturn); ?>">
					<div class="dw-consent-panel__actions">
						<button class="btn btn-outline-secondary" type="submit" name="consent" value="declined"><?php echo $this->translate('SHOPS_CONSENT_DECLINE'); ?></button>
						<button class="btn btn-primary" type="submit" name="consent" value="accepted"><?php echo $this->translate('SHOPS_CONSENT_ACCEPT'); ?></button>
						<?php if($analyticsConsent !== null) : ?>
							<button class="btn btn-link" type="button" data-consent-close><?php echo $this->translate('SHOPS_CLOSE'); ?></button>
						<?php endif; ?>
					</div>
				</form>
			</div>
		</section>
	<?php endif; ?>

	<script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha384-1H217gwSVyLSIfaLxHbE7dRb3v4mYCKbpQvzx0cegeju1MVsGrX5xXxAvs/HgeFs" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-Fy6S3B9q64WdZWQUiU+q4/2Lc9npb8tCaSX9FK7E8HnRr0Jz8D6OP9dO5Vg3Q9ct" crossorigin="anonymous"></script>
	<script type="text/javascript" src="<?php echo $this->baseUrl(); ?>/js/shops.js"></script>
	<?php if($analyticsAllowed) echo $shop['analytics']; ?>
	<?php if($analyticsAllowed && $analyticsEventInterface !== null && $conversionEvents) : ?>
		<script id="site-conversion-events" type="application/json"><?php echo json_encode($conversionEvents, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_SLASHES); ?></script>
		<script>dispatchSiteConversionElement(document.getElementById('site-conversion-events'));</script>
	<?php endif; ?>
</body>
</html>
